---
/**
 * Home page: hero, client logos, current work, why SAV, pharmaceutical
 * plants, the yard, and the enquiry. Section copy lives in data/story.ts.
 */
import { root } from '../lib/paths';
import Layout from '../theme/Layout.astro';
import YardHero from '../components/sections/YardHero.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import OnSite from '../components/sections/OnSite.astro';
import WhySav from '../components/sections/WhySav.astro';
import PharmaWork from '../components/sections/PharmaWork.astro';
import YardLedger from '../components/sections/YardLedger.astro';
import Enquiry from '../components/sections/Enquiry.astro';
import { company, quality, upcl } from '../data/company';
import { heroVideo } from '../data/story';
import { heroPoster } from '../lib/hero';

const base = `${root}`;
---

<Layout
  title={company.name}
  preloadImage={heroVideo ? heroPoster : undefined}
  fullTitle={`${company.name}, formerly UPCL | Industrial contractor, Indore`}
  description={`${company.name}, formerly ${upcl.short}, builds pharmaceutical plants, industrial sheds and factories in Indore, Pithampur and across India. ${quality.standard}, since ${company.established}.`}
>
  <YardHero base={base} />
  <TrustStrip />
  <OnSite base={base} number="01" />
  <WhySav base={base} number="02" />
  <PharmaWork base={base} number="03" />
  <YardLedger base={base} number="04" />
  <Enquiry base={base} />
</Layout>

<script>
  /*
   * Homepage motion. Nothing is hidden until this runs and the visitor allows
   * motion, so every section reads the same without it.
   */
  import { countUp, motionAllowed, reveal, scrollProgress } from '../lib/motion';

  if (motionAllowed()) {
    document.documentElement.classList.add('hm-motion');

    // Figures count up once their block arrives.
    const starters = new Map<Element, () => void>();
    document.querySelectorAll<HTMLElement>('[data-hm-count]').forEach((el) => {
      const start = countUp(el);
      if (start) starters.set(el, start);
    });

    reveal(document.querySelectorAll('[data-hm]'), {
      rootMargin: '0px 0px -10% 0px',
      threshold: 0.15,
      stagger: '--i',
      onIn: (el) => {
        const figure = el.querySelector('[data-hm-count]');
        if (figure) starters.get(figure)?.();
      },
    });

    // Sections that move with scroll: 0 as they enter, 1 once settled.
    scrollProgress(Array.from(document.querySelectorAll<HTMLElement>('[data-hm-progress]')), (rect, vh) => (vh - rect.top) / (vh * 0.8));
  }
</script>
