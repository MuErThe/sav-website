---
/**
 * Every photograph on the site, hung together as one shed: a sawtooth roof,
 * a wall of panels in mixed sizes framed in navy, and a ply edge for the
 * slab. The panel sizes are chosen in the browser so the wall always fills
 * completely; without JavaScript it is a plain even grid. The photos run project by project, then the yard, the laboratory and
 * the team, but nothing divides them. What a photo shows, and which project
 * it belongs to, appears over it on hover or focus.
 * Clicking a photo opens it full size in a lightbox that steps through the
 * whole set with the arrow keys or the on-screen arrows. Without JavaScript
 * each photo is a plain link to the full-size file.
 */
import { Image, getImage } from 'astro:assets';
import Layout from '../theme/Layout.astro';
import SawtoothRoof from '../components/SawtoothRoof.astro';
import { projects } from '../data/projects';
import { capabilityGallery, cultureGallery, galleryFor, usesPlaceholders, type GalleryImage } from '../lib/gallery';

interface Group {
  readonly title: string;
  readonly photos: readonly GalleryImage[];
}

const groups: Group[] = [
  ...projects
    .filter((project) => !usesPlaceholders(project.slug))
    .map((project) => ({ title: project.name, photos: galleryFor(project.slug) })),
  { title: 'Across our sites', photos: capabilityGallery('services') },
  { title: 'The yard', photos: capabilityGallery('warehouse') },
  { title: 'Testing laboratory', photos: capabilityGallery('quality') },
  { title: 'Our team', photos: cultureGallery() },
];

/** One flat run of photos, each remembering the project or place it came from. */
const photos = groups.flatMap((group) => group.photos.map((photo) => ({ photo, from: group.title })));

/** Full-size renditions for the lightbox, one per photo. */
const fullSize = await Promise.all(photos.map(({ photo }) => getImage({ src: photo.src })));

const total = photos.length;

---

<Layout
  title="Gallery: construction sites and plants"
  description="Photos of SAV Construction's pharmaceutical and industrial plants in Pithampur and Indore, our shuttering and scaffolding yard, testing laboratory and team."
>
  <section class="chapter gl" aria-labelledby="gallery-title" data-gl-root>
    <div class="shell">
      <h1 id="gallery-title" class="visually-hidden">Gallery: {total} photographs from our sites, our yard and our team</h1>

      <div class="gl-shed">
        <SawtoothRoof id="gl-roof" class="gl-roof" />
        <ul class="gl-grid" role="list" data-gl-grid>
          {
            photos.map(({ photo, from }, i) => {
              const full = fullSize[i]!;
              return (
                <li class="gl-item">
                  <a
                    class="gl-link"
                    href={full.src}
                    data-gl
                    data-gl-alt={photo.alt}
                    data-gl-title={`${from} · ${photo.caption}`}
                    aria-label={`Open full size: ${photo.alt}`}
                  >
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      widths={[360, Math.min(720, photo.src.width)]}
                      sizes="(max-width: 40rem) calc(100vw - 2.5rem), (max-width: 64rem) 45vw, 22rem"
                      loading={i < 6 ? 'eager' : 'lazy'}
                    />
                    <span class="gl-item__caption" aria-hidden="true">
                      <strong>{photo.caption}</strong>
                      <span>{from}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="ply-edge" aria-hidden="true"></div>
      </div>
    </div>

    <dialog class="gl-box" data-gl-box aria-label="Photo viewer">
      <div class="gl-box__bar">
        <p class="gl-box__count" aria-live="polite"><span data-gl-current>1</span><span class="gl-box__of">/ {total}</span></p>
        <button type="button" class="gl-box__btn" data-gl-close>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 3 10 10M13 3 3 13" /></svg>
          <span>Close</span>
        </button>
      </div>
      <figure class="gl-box__figure">
        <img class="gl-box__img" alt="" data-gl-img />
        <figcaption class="gl-box__caption">
          <strong data-gl-cap-title></strong>
          <span data-gl-cap-alt></span>
        </figcaption>
      </figure>
      <button type="button" class="gl-box__btn gl-box__arrow gl-box__arrow--prev" data-gl-prev aria-label="Previous photo">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
      </button>
      <button type="button" class="gl-box__btn gl-box__arrow gl-box__arrow--next" data-gl-next aria-label="Next photo">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
      </button>
    </dialog>
  </section>
</Layout>

<script>
  /*
   * Panel sizes. The wall is a dense CSS grid; this mirrors the browser's
   * placement so it can pick sizes that leave no empty cell. Every seventh
   * panel is 2 × 2 and every fourth after it is 2 × 1, then any gap that
   * would remain is closed by widening the panel beside or above it. If the
   * gaps cannot be closed, every panel goes back to 1 × 1 and the last one
   * stretches across the rest of its row.
   */
  const grid = document.querySelector<HTMLElement>('[data-gl-grid]');
  if (grid) {
    const panels = Array.from(grid.children) as HTMLElement[];
    type Rect = { r: number; c: number; w: number; h: number };

    const columns = () => getComputedStyle(grid).gridTemplateColumns.split(' ').length;

    /** Places every panel the way `grid-auto-flow: dense` would. */
    const pack = (shapes: [number, number][], C: number) => {
      const occ: boolean[][] = [];
      const taken = (r: number, c: number) => (occ[r] ??= Array<boolean>(C).fill(false))[c]!;
      const fits = (r: number, c: number, w: number, h: number) => {
        if (c + w > C) return false;
        for (let y = r; y < r + h; y++) for (let x = c; x < c + w; x++) if (taken(y, x)) return false;
        return true;
      };
      const rects: Rect[] = shapes.map(([w, h]) => {
        for (let r = 0; ; r++) {
          for (let c = 0; c < C; c++) {
            if (!fits(r, c, w, h)) continue;
            for (let y = r; y < r + h; y++) for (let x = c; x < c + w; x++) occ[y]![x] = true;
            return { r, c, w, h };
          }
        }
      });
      const holes: [number, number][] = [];
      occ.forEach((row, r) => row.forEach((cell, c) => cell || holes.push([r, c])));
      return { rects, holes };
    };

    const layout = () => {
      const C = columns();
      const n = panels.length;
      let shapes: [number, number][] = panels.map((_, i) => {
        if (C < 4 || n < 6) return [1, 1];
        if (i % 7 === 0) return [2, 2];
        if (i % 7 === 4) return [2, 1];
        return [1, 1];
      });

      let result = pack(shapes, C);
      for (let guard = 0; result.holes.length && guard < 40; guard++) {
        const [r, c] = result.holes[0]!;
        // A panel ending just left of the hole, or just above it, grows to cover it.
        const left = result.rects.findIndex((q) => q.c + q.w === c && q.r <= r && r < q.r + q.h && q.h === 1);
        const above = result.rects.findIndex((q) => q.r + q.h === r && q.c <= c && c < q.c + q.w && q.w === 1);
        if (left !== -1) shapes[left] = [shapes[left]![0] + 1, shapes[left]![1]];
        else if (above !== -1) shapes[above] = [shapes[above]![0], shapes[above]![1] + 1];
        else break;
        result = pack(shapes, C);
      }

      if (result.holes.length) {
        shapes = panels.map(() => [1, 1]);
        const rest = n % C;
        if (rest) shapes[n - 1] = [C - rest + 1, 1];
      }

      panels.forEach((panel, i) => {
        const [w, h] = shapes[i]!;
        panel.style.gridColumn = w > 1 ? `span ${w}` : '';
        panel.style.gridRow = h > 1 ? `span ${h}` : '';
      });
    };

    let lastColumns = 0;
    const relayout = () => {
      const C = columns();
      if (C === lastColumns) return;
      lastColumns = C;
      layout();
    };
    relayout();
    new ResizeObserver(relayout).observe(grid);
  }

  const root = document.querySelector<HTMLElement>('[data-gl-root]');
  const box = root?.querySelector<HTMLDialogElement>('[data-gl-box]');
  const img = box?.querySelector<HTMLImageElement>('[data-gl-img]');
  const capTitle = box?.querySelector<HTMLElement>('[data-gl-cap-title]');
  const capAlt = box?.querySelector<HTMLElement>('[data-gl-cap-alt]');
  const current = box?.querySelector<HTMLElement>('[data-gl-current]');

  if (root && box && img && capTitle && capAlt && current && typeof box.showModal === 'function') {
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-gl]'));
    let index = 0;

    const preload = (i: number) => {
      const link = links[(i + links.length) % links.length];
      if (link) new Image().src = link.href;
    };

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index]!;
      img.src = link.href;
      img.alt = link.dataset.glAlt ?? '';
      capTitle.textContent = link.dataset.glTitle ?? '';
      capAlt.textContent = link.dataset.glAlt ?? '';
      current.textContent = String(index + 1);
      preload(index + 1);
      preload(index - 1);
    };

    links.forEach((link, i) => {
      link.addEventListener('click', (event) => {
        // Plain clicks open the viewer; modified clicks keep their browser meaning.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        show(i);
        box.showModal();
      });
    });

    box.querySelector('[data-gl-prev]')?.addEventListener('click', () => show(index - 1));
    box.querySelector('[data-gl-next]')?.addEventListener('click', () => show(index + 1));
    box.querySelector('[data-gl-close]')?.addEventListener('click', () => box.close());

    box.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    // Clicking the dark surround, outside the photo and its controls, closes the viewer.
    box.addEventListener('click', (event) => {
      if (event.target === box) box.close();
    });

    // Drop the full-size image once closed so the next open never flashes the old one.
    box.addEventListener('close', () => {
      img.removeAttribute('src');
      links[index]?.focus();
    });
  }
</script>

<style>
  /* One shed: sawtooth roof, a wall of panels framed in navy, and the ply
     edge as the slab. The words rise over a panel on hover or keyboard
     focus; a click opens the viewer. */
  .gl-shed {
    margin-top: 0;
  }

  .gl-shed :global(.gl-roof) {
    display: block;
    width: 100%;
    height: 2.5rem;
  }

  .gl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    grid-auto-rows: clamp(8rem, 12vw, 11rem);
    grid-auto-flow: dense;
    gap: 6px;
    padding: 0 6px;
    margin: 0;
    background: var(--navy);
  }

  .gl-link {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--band);
    isolation: isolate;
  }

  .gl-link :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .gl-link:hover :global(img),
  .gl-link:focus-visible :global(img) {
    transform: scale(1.04);
  }

  .gl-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 3px solid var(--orange);
    opacity: 0;
    transition: opacity 200ms ease;
    pointer-events: none;
  }

  .gl-link:hover::after,
  .gl-link:focus-visible::after {
    opacity: 1;
  }

  .gl-link:focus-visible {
    outline: 3px solid var(--blue-text);
    outline-offset: 3px;
  }


  .gl-item__caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 0.2rem;
    padding: 2.5rem 1rem 1rem;
    background: linear-gradient(to top, rgb(11 31 58 / 0.96) 0%, rgb(11 31 58 / 0.85) 55%, rgb(11 31 58 / 0) 100%);
    color: #fff;
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 220ms ease,
      transform 320ms var(--ease-out);
  }

  .gl-link:hover .gl-item__caption,
  .gl-link:focus-visible .gl-item__caption {
    opacity: 1;
    transform: none;
  }

  .gl-item__caption strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--orange);
  }

  .gl-item__caption span {
    font-size: 0.85rem;
    line-height: 1.45;
  }

  /* ---------------------------------------------------------------- viewer */

  .gl-box {
    position: fixed;
    inset: 0;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }

  .gl-box::backdrop {
    background: rgb(11 31 58 / 0.94);
  }

  .gl-box[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .gl-box__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--gutter);
  }

  .gl-box__count {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 900;
    line-height: 1;
  }

  .gl-box__of {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--orange);
  }

  .gl-box__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
    min-height: 0;
    margin: 0;
    padding: 0 clamp(4rem, 8vw, 7rem) 1.5rem;
  }

  /* The photo shrinks to fit but is never enlarged past its own pixels, so
     a small original stays sharp in the middle of the screen. */
  .gl-box__img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    justify-self: center;
    align-self: center;
  }

  .gl-box__caption {
    display: grid;
    gap: 0.25rem;
    max-width: 70ch;
    margin-inline: auto;
    text-align: center;
  }

  .gl-box__caption strong {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .gl-box__caption span {
    font-size: 0.95rem;
    color: #d5deea;
  }

  .gl-box__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 2px solid #fff;
    background: transparent;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .gl-box__btn svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gl-box__btn:hover {
    border-color: var(--orange);
    background: var(--orange);
    color: var(--navy);
  }

  .gl-box__btn:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }

  .gl-box__arrow {
    position: absolute;
    top: 50%;
    padding: 0;
    width: 3.25rem;
    height: 3.25rem;
    transform: translateY(-50%);
  }

  .gl-box__arrow--prev {
    left: clamp(0.75rem, 2vw, 2rem);
  }

  .gl-box__arrow--next {
    right: clamp(0.75rem, 2vw, 2rem);
  }

  @media (max-width: 40rem) {
    .gl-box__figure {
      padding-inline: 1rem;
    }

    /* Arrows move under the photo so they never cover it on a phone. */
    .gl-box__arrow {
      top: auto;
      bottom: 1rem;
      transform: none;
    }

    .gl-box__figure {
      padding-bottom: 5.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gl-link :global(img),
    .gl-link::after,
    .gl-item__caption {
      transition: none;
    }

    .gl-link:hover :global(img),
    .gl-link:focus-visible :global(img) {
      transform: none;
    }
  }
</style>
