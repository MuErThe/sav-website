---
import Layout from '../theme/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { contact, company, upcl } from '../data/company';
import { enquiry } from '../data/story';

/** A Google Maps search for an office address. */
const mapsHref = (lines: readonly string[]) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(lines.join(', '))}`;

const lines = [
  { label: 'Call', value: contact.phone, href: contact.phoneHref },
  { label: 'Email', value: contact.email, href: contact.emailHref },
];
---

<Layout
  title="Contact SAV Construction, Indore"
  description={`Talk to ${company.name}, formerly ${upcl.short}, about an industrial or pharmaceutical project. Call ${contact.phone}, email ${contact.email}, or send an enquiry.`}
>
  <!-- 01 · The quickest routes first: phone and email, set as large as the page allows. -->
  <section class="ct-open" aria-labelledby="contact-title">
    <div class="shell">
      <p class="section-no" aria-hidden="true">01</p>
      <h1 id="contact-title" class="section-title">Start an enquiry</h1>
      <p class="lede">{enquiry.lede}</p>

      <ul class="ct-lines" role="list">
        {
          lines.map((line, i) => (
            <li class="ct-line" data-ct style={`--i:${i}`}>
              <span class="ct-line__label">{line.label}</span>
              <a class="ct-line__link" href={line.href}>
                <span class="ct-line__value">{line.value}</span>
                <svg class="ct-line__arrow" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M3 9 9 3 M4.5 3H9v4.5" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 02 · The form, with the offices pinned alongside it. -->
  <section class="chapter chapter--raised ct-send" aria-labelledby="send-title">
    <div class="shell ct-send__grid">
      <div class="ct-form" data-ct>
        <p class="section-no" aria-hidden="true">02</p>
        <h2 id="send-title" class="section-title ct-send__title">Send the details</h2>
        <ContactForm />
      </div>

      <aside class="ct-offices" aria-labelledby="offices-title">
        <h2 id="offices-title" class="ct-offices__title">Our offices</h2>
        <p class="ct-offices__name">{company.legalName}</p>
        <ul class="ct-offices__list" role="list">
          {
            contact.offices.map((office, i) => (
              <li class="ct-office" data-ct style={`--i:${i}`}>
                <p class="ct-office__label">{office.label}</p>
                <address class="ct-office__address">
                  {office.lines.map((line) => <span>{line}</span>)}
                </address>
                <a class="text-link" href={mapsHref(office.lines)} target="_blank" rel="noopener noreferrer">
                  Open in Google Maps<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>
</Layout>

<style>
  /* -------------------------------------------------------------- opening */

  .ct-open {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem);
  }

  .ct-lines {
    padding: 0;
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0;
    border-top: 3px solid var(--navy);
  }

  /* Call and email sit side by side, a rule between them; phones stack them. */
  .ct-lines {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ct-line {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.5rem;
    padding-top: clamp(1rem, 2vw, 1.5rem);
    /* The figures size to their column, so the email always fits on one line. */
    container-type: inline-size;
  }

  .ct-line + .ct-line {
    padding-left: clamp(1rem, 2.5vw, 2rem);
    border-left: 2px solid var(--navy);
  }

  .ct-line__label {
    padding-inline: 0.75rem;
  }

  /* Each rule draws across as its line arrives. */
  .ct-line::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--navy);
    transform-origin: left;
  }

  .ct-line__label {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue-text);
  }

  .ct-line__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(0.9rem, 2vw, 1.4rem) 0.75rem;
    color: var(--ink);
    text-decoration: none;
    isolation: isolate;
  }

  .ct-line__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 420ms var(--ease-out);
  }

  .ct-line__link:hover::before,
  .ct-line__link:focus-visible::before {
    transform: scaleX(1);
  }

  .ct-line__link:hover,
  .ct-line__link:focus-visible {
    color: var(--navy);
  }

  .ct-line__link:focus-visible {
    outline: 3px solid var(--sav-blue);
    outline-offset: 2px;
  }

  .ct-line__value {
    min-width: 0;
    font-size: clamp(1.4rem, 9cqi, 4.5rem);
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 0.95;
    overflow-wrap: anywhere;
  }

  .ct-line__arrow {
    flex-shrink: 0;
    width: clamp(1.5rem, 1rem + 2vw, 3rem);
    height: clamp(1.5rem, 1rem + 2vw, 3rem);
    fill: none;
    stroke: var(--sav-blue);
    stroke-width: 1.6;
    transition: transform 300ms var(--ease-out);
  }

  .ct-line__link:hover .ct-line__arrow,
  .ct-line__link:focus-visible .ct-line__arrow {
    stroke: var(--navy);
    transform: translate(0.25rem, -0.25rem);
  }

  /* ---------------------------------------------------------------- form */

  .ct-send__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .ct-send__title {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* Fields drawn as lines on the sheet rather than boxes. */
  .ct-form :global(.field__label) {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .ct-form :global(.field__input) {
    padding-inline: 0;
    border: 0;
    border-bottom: 2px solid var(--navy);
    background-color: transparent;
    font-size: 1.1rem;
    transition: border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }

  .ct-form :global(.field__input:hover) {
    background-color: var(--paper);
  }

  /* No outline on focus, at the user's request: the underline turns blue and
     thickens, and the field fills white, so the active field still stands out. */
  .ct-form :global(.field__input:focus),
  .ct-form :global(.field__input:focus-visible) {
    outline: none;
    border-bottom-color: var(--blue-text);
    box-shadow: inset 0 -1px 0 var(--blue-text);
    background-color: var(--card);
  }

  .ct-form :global(.field__textarea:focus),
  .ct-form :global(.field__textarea:focus-visible) {
    border-color: var(--blue-text);
    box-shadow: inset 0 0 0 1px var(--blue-text);
  }

  .ct-form :global(.field__textarea) {
    padding: 0.75rem;
    border: 2px solid var(--navy);
  }

  .ct-form :global(.field__select) {
    padding-right: 2rem;
    background-position: calc(100% - 0.85rem) 1.35rem, calc(100% - 0.5rem) 1.35rem;
  }

  .ct-form :global(.field__input[aria-invalid='true']) {
    border-color: #a4161a;
    box-shadow: none;
  }

  .ct-form :global(.enquiry__grid) {
    gap: 2rem 2.5rem;
  }

  /* -------------------------------------------------------------- offices */

  .ct-offices {
    position: sticky;
    top: 6rem;
    padding-top: 1.5rem;
    border-top: 8px solid var(--blue);
  }

  .ct-offices__title {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue-text);
  }

  .ct-offices__name {
    margin-top: 0.75rem;
    font-size: 1.3rem;
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .ct-offices__list {
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .ct-office {
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .ct-office__label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .ct-office__address {
    display: grid;
    margin: 0.5rem 0 0.75rem;
    font-size: 1.05rem;
    font-style: normal;
    font-weight: 600;
  }

  /* --------------------------------------------------------------- motion */

  :global(.ct-motion) .ct-line[data-ct]::after {
    transform: scaleX(0);
    transition: transform 900ms var(--ease-out);
    transition-delay: calc(var(--i) * 150ms + 150ms);
  }

  :global(.ct-motion) .ct-line[data-ct] .ct-line__link {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 700ms var(--ease-out),
      transform 800ms var(--ease-out);
    transition-delay: calc(var(--i) * 150ms);
  }

  :global(.ct-motion) .ct-line[data-ct].is-in::after {
    transform: scaleX(1);
  }

  :global(.ct-motion) .ct-line[data-ct].is-in .ct-line__link {
    opacity: 1;
    transform: none;
  }

  :global(.ct-motion) .ct-form[data-ct],
  :global(.ct-motion) .ct-office[data-ct] {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 700ms var(--ease-out),
      transform 800ms var(--ease-out);
    transition-delay: calc(var(--i, 0) * 120ms);
  }

  :global(.ct-motion) .ct-form[data-ct].is-in,
  :global(.ct-motion) .ct-office[data-ct].is-in {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 56rem) {
    .ct-send__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .ct-offices {
      position: static;
    }
  }

  @media (max-width: 44rem) {
    .ct-lines {
      grid-template-columns: minmax(0, 1fr);
    }

    .ct-line + .ct-line {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ct-line__link::before,
    .ct-line__arrow {
      transition: none;
    }
  }
</style>

<script>
  // Nothing is hidden until this runs and the visitor allows motion.
  import { motionAllowed, reveal } from '../lib/motion';

  if (motionAllowed()) {
    document.documentElement.classList.add('ct-motion');
    reveal(document.querySelectorAll('[data-ct]'), { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
  }
</script>
