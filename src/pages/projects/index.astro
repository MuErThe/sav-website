---
/**
 * Projects list, grouped by sector, each with its photo carousel.
 */
import { root } from '../../lib/paths';
import Layout from '../../theme/Layout.astro';
import ProjectRecord from '../../components/ProjectRecord.astro';
import { projects, projectsNote, activeSectors } from '../../data/projects';
---

<Layout
  title="Projects: pharmaceutical and industrial plants"
  description="Pharmaceutical plants, industrial sheds and factory buildings by SAV Construction, formerly UPCL, for Alembic, Sava Healthcare, Lupin, Gufic, Dabur and Welspun."
>
  <section class="chapter" aria-labelledby="projects-title">
    <div class="shell">
      <header class="pj-head">
        <p class="section-no" aria-hidden="true">01</p>
        <h1 id="projects-title" class="section-title">Recent and ongoing sites</h1>
        <p class="lede">{projectsNote}</p>
      </header>

      <!-- Filtering is progressive: without JavaScript every project is listed. -->
      <div class="filters" data-filters hidden>
        <fieldset class="filters__set">
          <legend class="filters__legend">Filter by sector</legend>
          <button type="button" class="pill filters__btn" data-filter="all" aria-pressed="true">
            All projects <span class="filters__count">{projects.length}</span>
          </button>
          {
            activeSectors.map((sector) => (
              <button type="button" class="pill filters__btn" data-filter={sector} aria-pressed="false">
                {sector}
                <span class="filters__count">
                  {projects.filter((p) => p.sector === sector).length}
                </span>
              </button>
            ))
          }
        </fieldset>
        <p class="filters__status" role="status" aria-live="polite" data-filter-status></p>
      </div>

      <ul class="records" role="list" data-project-list>
        {projects.map((project) => <ProjectRecord project={project} base={`${root}`} level={2} />)}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .pj-head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .filters {
    margin-top: -1rem;
  }

  .filters__set {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    border: 0;
    margin: 0;
  }

  .filters__legend {
    padding: 0;
    margin-bottom: 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .filters__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .filters__btn:hover {
    border-color: var(--navy);
  }

  /* Selected state uses fill, border and a tick, never colour alone. */
  .filters__btn[aria-pressed='true'] {
    background: var(--blue);
    border-color: var(--navy);
    color: var(--on-blue);
  }

  .filters__btn[aria-pressed='true']::before {
    content: '\2713';
    font-weight: 700;
  }

  .filters__count {
    font-size: 0.8rem;
    opacity: 0.75;
  }

  .filters__status {
    margin-top: 1rem;
    font-size: 0.92rem;
    color: var(--ink-muted);
  }
</style>

<script>
  const wrapper = document.querySelector<HTMLElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-project-list]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (wrapper && list) {
    // Only reveal the controls once we know JavaScript can drive them.
    wrapper.hidden = false;

    const buttons = Array.from(wrapper.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(list.children) as HTMLElement[];

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

        let shown = 0;
        cards.forEach((card) => {
          const sector = card.dataset.sector;
          const match = filter === 'all' || sector === filter;
          card.hidden = !match;
          if (match) shown += 1;
        });

        if (status) {
          status.textContent =
            filter === 'all'
              ? `Showing all ${shown} projects.`
              : `Showing ${shown} ${filter.toLowerCase()} project${shown === 1 ? '' : 's'}.`;
        }
      });
    });
  }
</script>
