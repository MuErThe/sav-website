---
/**
 * Scroll reveal for the shared building blocks: section heads, project
 * records, people, the call to action, site boards and ply edges. Used once,
 * in the layout. Pages with their own choreography add their own hooks.
 *
 * Progressive enhancement: nothing is hidden until this script has confirmed
 * both JavaScript and the user's motion preference, so content is always
 * reachable without it. Reduced-motion users get every element in place.
 */
---

<script>
  import { motionAllowed, reveal } from '../lib/motion';

  const REVEAL = ['.chapter__head', '.record', '.zero', '.person', '.call', '.board', '.ply-edge'].join(',');

  if (motionAllowed()) {
    document.documentElement.classList.add('motion');
    const targets = document.querySelectorAll(REVEAL);
    targets.forEach((el) => el.classList.add('reveal'));
    reveal(targets, { rootMargin: '0px 0px -8% 0px', threshold: 0.12, stagger: '--reveal-i' });
  }
</script>
