---
/**
 * Scroll reveal for the shared building blocks: section heads, project
 * records, people, the call to action, site boards and ply edges. Used once,
 * in the layout. Pages with their own choreography add their own hooks.
 *
 * Progressive enhancement: nothing is hidden until this script has confirmed
 * both JavaScript and the user's motion preference, so content is always
 * reachable without it. Reduced-motion users get every element in place.
 */
---

<script>
  const REVEAL = ['.chapter__head', '.record', '.zero', '.person', '.call', '.board', '.ply-edge'].join(',');

  function start(): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

    document.documentElement.classList.add('motion');

    const targets = Array.from(document.querySelectorAll<HTMLElement>(REVEAL));
    targets.forEach((el) => el.classList.add('reveal'));

    const observer = new IntersectionObserver(
      (entries) => {
        // Stagger only what arrives together, capped so long lists stay brisk;
        // an item further down a list never waits on its place in it.
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, order) => {
            const el = entry.target as HTMLElement;
            el.style.setProperty('--reveal-i', String(Math.min(order, 6)));
            el.classList.add('is-in');
            observer.unobserve(el);
          });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
    );

    targets.forEach((el) => observer.observe(el));
  }

  start();
</script>
