---
/**
 * The UPCL mark, redrawn as a vector from the company profile deck: an orange
 * square divided by white lines that spell the initials. The only raster in
 * the repo is 29 px, too small to show at brand size.
 */
interface Props {
  class?: string;
  /** Accessible name; leave empty when a visible "UPCL" label sits beside it. */
  label?: string;
}

const { class: className, label = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <rect width="100" height="100" fill="#f58025"></rect>
  <g stroke="#fff" stroke-width="3" fill="none" stroke-linecap="square">
    <path d="M49 0V100M0 51.5H100"></path>
    <path d="M26 0V25"></path>
    <path d="M80 12H90M100 25H73V77H100"></path>
    <path d="M26 78H49"></path>
  </g>
</svg>
