---
/** One role in the org flow: its card, then its reports as a nested list. */
import type { OrgNode } from '../../data/people';

interface Props {
  node: OrgNode;
  depth?: number;
}

const { node, depth = 0 } = Astro.props;

/** 24 × 24 line icons, one per department or role. */
const ICONS: Record<string, string> = {
  Director: 'M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9Z',
  'General Manager': 'M4 21V5h10v16 M14 9h6v12 M7 8h3 M7 12h3 M7 16h3 M17 13h1 M17 17h1 M2 21h20',
  'Finance & Accounting':
    'M12 4c4 0 7 1.3 7 3s-3 3-7 3-7-1.3-7-3 3-3 7-3Z M5 7v5c0 1.7 3 3 7 3s7-1.3 7-3V7 M5 12v5c0 1.7 3 3 7 3s7-1.3 7-3v-5',
  'Head Accountant': 'M6 3h12v18H6Z M9 6h6v3H9Z M9 13h1 M12 13h1 M15 13h1 M9 17h1 M12 17h1 M15 17h1',
  '4 Accountants': 'M6 3h12v18H6Z M9 6h6v3H9Z M9 13h1 M12 13h1 M15 13h1 M9 17h1 M12 17h1 M15 17h1',
  HR: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6 M16 11a2.5 2.5 0 1 0 0-5 M17 14c2.4.4 4 2.6 4 5',
  'Project Manager': 'M8 3h8v3H8Z M6 4H4v17h16V4h-2 M8 12l2 2 4-4 M8 17h8',
  Sites: 'M5 21V4 M5 4h15 M5 4l4 3 M17 4v5 M15 9h4v3h-4Z M3 21h6 M5 8h3 M5 12h3 M5 16h3',
  'Construction Managers': 'M3 17h18 M5 17a7 7 0 0 1 14 0 M12 10V6 M9 11V8 M15 11V8 M4 17v2h16v-2',
  'Sub-contractors': 'M2 12l4-4 4 3 2-1 2 1 4-3 4 4 M6 12l4 4 M9 15l2 2 M12 13l3 3 M14 11l3 3',
  'Site Engineers': 'M9 5h6v5H9Z M15 7h3 M12 10v3 M12 13l-5 8 M12 13l5 8 M12 13v8',
  Mechanics: 'M14.5 4a4 4 0 0 0-3.9 5.2L4 15.8 6.2 18l6.6-6.6A4 4 0 0 0 18 7.5l-2.3 2.3-2.2-.6-.6-2.2Z',
  Electricians: 'M13 3 5 13h6l-1 8 8-10h-6Z',
  'Quality & Safety': 'M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6Z M9 12l2 2 4-4',
  'Billing Engineers': 'M6 3h12v18l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5L6 21Z M9 8h6 M9 12h6 M9 16h3',
  Assistants: 'M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z M5 21c0-3.9 3.1-7 7-7s7 3.1 7 7',
  'Centralised Warehouse': 'M3 21V9l9-5 9 5v12 M7 21v-8h10v8 M7 17h10',
  'Purchase Manager': 'M3 4h2l2.4 11h10.6l2-8H6.3 M9 20h.01 M17 20h.01',
  'Store Keeper': 'M4 13h7v8H4Z M13 13h7v8h-7Z M8.5 5h7v8h-7Z',
  Foreman: 'M4 10v4h3l7 4V6l-7 4Z M17 9a4 4 0 0 1 0 6',
  'Unskilled Labour': 'M14 3l7 7 M17.5 6.5 9 15 M9 15l-3-1-3 3 4 4 3-3-1-3Z',
};
const icon = ICONS[node.title] ?? ICONS.Assistants!;
---

<li>
  <span class="orgflow__card" data-depth={depth}>
    <svg class="orgflow__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d={icon}></path>
    </svg>
    <span class="orgflow__title">{node.title}</span>
  </span>
  {
    node.children && (
      <ul role="list">
        {node.children.map((child) => (
          <Astro.self node={child} depth={depth + 1} />
        ))}
      </ul>
    )
  }
</li>
