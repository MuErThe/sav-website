---
/**
 * The director's seven differentiators as a hard-ruled board. The track
 * record leads in a blue block; the point marked `highlight` (the in-house
 * shuttering workshop) stands in an orange cell with a tag, so it is singled
 * out by more than colour.
 */
import { why } from '../../data/story';
import { whySav } from '../../data/company';

interface Props {
  base: string;
  number?: string;
}

const { base, number = '02' } = Astro.props;
---

<section class="chapter hm-why" aria-labelledby="why-title">
  <div class="shell">
    <header class="chapter__head">
      <p class="section-no" aria-hidden="true">{number}</p>
      <h2 id="why-title" class="section-title">{why.title}</h2>
      <p class="lede">{why.lede}</p>
    </header>

    <ol class="hm-why__grid" role="list">
      {
        whySav.map((point, i) => (
          <li class:list={['hm-why__cell', { 'hm-why__cell--key': point.highlight }]} data-hm style={`--i:${i}`}>
            <span class="hm-why__no" aria-hidden="true">{point.number}</span>
            <h3 class="hm-why__name">
              {point.title}
              {point.highlight && <span class="hm-why__tag">Our edge</span>}
            </h3>
            <p class="hm-why__body">{point.body}</p>
          </li>
        ))
      }
    </ol>

    <a class="text-link" href={`${base}/about/#why`}>More about how we work</a>
  </div>
</section>

<style>
  .hm-why__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    border-top: 3px solid var(--navy);
    border-left: 3px solid var(--navy);
  }

  .hm-why__cell {
    grid-column: span 2;
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-right: 3px solid var(--navy);
    border-bottom: 3px solid var(--navy);
    background: var(--card);
  }

  /* The first cell runs the full row; the other six close two rows of three. */
  .hm-why__cell:first-child {
    grid-column: span 6;
    background: var(--blue);
    color: var(--on-blue);
  }

  .hm-why__no {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 1.8rem + 2.4vw, 4.2rem);
    font-weight: 900;
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 2px var(--blue-text);
  }

  .hm-why__cell:first-child .hm-why__no {
    -webkit-text-stroke-color: var(--orange);
  }

  .hm-why__cell--key {
    background: var(--orange);
    color: var(--navy);
  }

  .hm-why__cell--key .hm-why__no {
    -webkit-text-stroke-color: var(--navy);
  }

  .hm-why__cell--key .hm-why__body {
    color: var(--navy);
  }

  .hm-why__tag {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.3rem 0.5rem 0.25rem;
    background: var(--navy);
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    vertical-align: 0.35em;
    color: #fff;
  }

  .hm-why__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.2rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .hm-why__body {
    color: var(--ink-muted);
  }

  .hm-why__cell:first-child .hm-why__body {
    color: var(--on-blue);
  }

  :global(.hm-motion) .hm-why__cell[data-hm] {
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 600ms var(--ease-out),
      transform 700ms var(--ease-out);
    transition-delay: calc(var(--i) * 90ms);
  }

  :global(.hm-motion) .hm-why__cell[data-hm].is-in {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 56rem) {
    .hm-why__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hm-why__cell,
    .hm-why__cell:first-child {
      grid-column: auto;
    }
  }
</style>
