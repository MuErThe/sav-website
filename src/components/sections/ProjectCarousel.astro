---
/**
 * Project photographs, one at a time. The slides are a scroll-snapped strip,
 * so without JavaScript they still swipe and scroll; the script adds the
 * buttons, counter and progress rule. It never auto-plays.
 *
 * `card` sits in a project record: compact, with the controls over the photo,
 * and a click on the photo opens the project. `feature` is the large version
 * for a project page, with captions.
 */
import { Image } from 'astro:assets';
import type { GalleryImage } from '../../lib/gallery';

interface Props {
  images: readonly GalleryImage[];
  /** Accessible name, e.g. "Sava Healthcare photographs". */
  label: string;
  variant?: 'card' | 'feature';
  /** Card only: where a click on the photo leads. */
  href?: string;
}

const { images, label, variant = 'card', href } = Astro.props;
const total = images.length;
const many = total > 1;
const pad = (n: number) => String(n).padStart(2, '0');
const widths = variant === 'card' ? [420, 720, 1040] : [800, 1400, 2000];
const sizes =
  variant === 'card'
    ? '(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw'
    : '(max-width: 1200px) 100vw, 1200px';
---

<section
  class={`pc pc--${variant}`}
  aria-roledescription="carousel"
  aria-label={label}
  data-pc
  data-href={href}
>
  <div
    class="pc__viewport"
    data-pc-viewport
    tabindex={many ? 0 : undefined}
    role={many ? 'region' : undefined}
    aria-label={many ? `${label}, scroll sideways for more` : undefined}
  >
    <div class="pc__track">
      {
        images.map((image, i) => (
          <div class="pc__slide" data-caption={image.caption} role="group" aria-roledescription="slide" aria-label={`Photo ${i + 1} of ${total}`}>
            <Image
              src={image.src}
              alt={image.alt}
              widths={widths}
              sizes={sizes}
              loading={i === 0 && variant === 'feature' ? 'eager' : 'lazy'}
              decoding="async"
              class="pc__image"
            />
          </div>
        ))
      }
    </div>
  </div>

  {
    many && (
      <div class="pc__controls" data-pc-controls hidden>
        <p class="pc__count" aria-hidden="true">
          <span data-pc-current>01</span>
          <span class="pc__of">/ {pad(total)}</span>
        </p>
        {variant === 'feature' && (
          <p class="pc__caption" aria-hidden="true" data-pc-caption>
            {images[0]!.caption}
          </p>
        )}
        <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-pc-status></p>
        <div class="pc__buttons">
          <button type="button" class="pc__btn" data-pc-prev aria-label="Previous photo">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
          </button>
          <button type="button" class="pc__btn" data-pc-next aria-label="Next photo">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
          </button>
        </div>
        <span class="pc__progress" aria-hidden="true">
          <span class="pc__progress-fill" data-pc-fill style={`--n:${total}`}></span>
        </span>
      </div>
    )
  }

</section>

<style>
  .pc {
    position: relative;
  }

  .pc__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
  }

  .pc__viewport:focus-visible {
    outline: 3px solid var(--sav-blue);
    outline-offset: 3px;
  }

  /* Once the buttons work, the strip no longer needs its scrollbar. */
  .pc[data-pc-ready] .pc__viewport {
    scrollbar-width: none;
  }

  .pc[data-pc-ready] .pc__viewport::-webkit-scrollbar {
    display: none;
  }

  .pc__track {
    display: flex;
    padding: 0;
    margin: 0;
  }

  .pc__slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .pc__image {
    display: block;
    width: 100%;
    object-fit: cover;
  }

  .pc__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 2px solid var(--navy);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .pc__btn svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: square;
  }

  .pc__btn:hover {
    background: var(--blue);
    color: var(--on-blue);
  }

  .pc__btn:active {
    transform: translateY(1px);
  }

  .pc__btn:focus-visible {
    outline: 3px solid var(--sav-blue);
    outline-offset: 2px;
  }

  .pc__buttons {
    display: flex;
    gap: 0.4rem;
  }

  .pc__count {
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
    color: var(--ink);
  }

  .pc__of {
    color: var(--ink-muted);
  }

  .pc__progress {
    position: relative;
    display: block;
    height: 3px;
    background: var(--hairline);
  }

  .pc__progress-fill {
    --i: 0;
    position: absolute;
    inset: 0;
    background: var(--blue-text);
    transform-origin: left;
    transform: scaleX(calc((var(--i) + 1) / var(--n)));
    transition: transform 400ms var(--ease-out);
  }

  /* ------------------------------------------------------------------ card */

  /* Above the record's full-card link, so swipes and buttons reach it. */
  .pc--card {
    z-index: 1;
  }

  .pc--card[data-href] .pc__viewport {
    cursor: pointer;
  }

  .pc--card .pc__image {
    height: clamp(12rem, 20vw, 15rem);
    filter: saturate(0.9) contrast(1.05);
  }

  .pc--card .pc__controls {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    left: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .pc--card .pc__controls > * {
    pointer-events: auto;
  }

  .pc--card .pc__count {
    padding: 0.35rem 0.55rem;
    background: var(--navy);
    font-size: 0.85rem;
    color: var(--paper);
  }

  .pc--card .pc__of {
    color: var(--hairline);
  }

  .pc--card .pc__btn {
    width: 2.25rem;
    height: 2.25rem;
  }

  .pc--card .pc__progress {
    position: absolute;
    right: -0.6rem;
    bottom: -0.6rem;
    left: -0.6rem;
    background: transparent;
  }

  .pc--card .pc__progress-fill {
    background: var(--blue);
  }

  /* --------------------------------------------------------------- feature */

  .pc--feature .pc__viewport {
    border: 3px solid var(--orange);
  }

  /* One stage height for every photo, each filling the frame edge to edge. */
  .pc--feature .pc__slide {
    height: min(72vh, 58vw);
  }

  .pc--feature .pc__image {
    height: 100%;
  }

  .pc--feature .pc__controls {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.75rem clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    margin-top: 1.25rem;
  }

  .pc--feature .pc__count {
    font-size: clamp(2.2rem, 1.6rem + 2vw, 3.4rem);
  }

  .pc--feature .pc__caption {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .pc--feature .pc__btn {
    width: 3.25rem;
    height: 3.25rem;
  }

  .pc--feature .pc__progress {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  @media (max-width: 36rem) {
    .pc--feature .pc__controls {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }

    .pc--feature .pc__caption {
      grid-column: 1 / -1;
      grid-row: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc__progress-fill,
    .pc__btn {
      transition: none;
    }
  }
</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pad = (n: number) => String(n).padStart(2, '0');

  document.querySelectorAll<HTMLElement>('[data-pc]').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('[data-pc-viewport]');
    const controls = root.querySelector<HTMLElement>('[data-pc-controls]');
    if (!viewport || !controls) return;

    const slides = Array.from(viewport.querySelectorAll<HTMLElement>('.pc__slide'));
    const current = root.querySelector<HTMLElement>('[data-pc-current]');
    const caption = root.querySelector<HTMLElement>('[data-pc-caption]');
    const status = root.querySelector<HTMLElement>('[data-pc-status]');
    const fill = root.querySelector<HTMLElement>('[data-pc-fill]');
    let index = 0;

    // The buttons join the strip as a second keyboard route; the strip stays
    // focusable so its scroll area is reachable, and arrow keys move it.
    controls.hidden = false;
    root.dataset.pcReady = '';

    const show = (i: number, announce: boolean) => {
      index = i;
      if (current) current.textContent = pad(i + 1);
      if (fill) fill.style.setProperty('--i', String(i));
      if (caption) caption.textContent = slides[i]?.dataset.caption ?? '';
      slides.forEach((slide, n) => slide.setAttribute('aria-hidden', String(n !== i)));
      if (announce && status) status.textContent = `Photo ${i + 1} of ${slides.length}`;
    };

    const go = (i: number) => {
      const target = (i + slides.length) % slides.length;
      // Wrapping jumps rather than sweeping back past every photo.
      const wraps = Math.abs(target - index) > 1;
      viewport.scrollTo({ left: target * viewport.clientWidth, behavior: calm.matches || wraps ? 'auto' : 'smooth' });
      show(target, true);
    };

    root.querySelector('[data-pc-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-pc-next]')?.addEventListener('click', () => go(index + 1));

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') go(index - 1);
      else if (event.key === 'ArrowRight') go(index + 1);
      else return;
      event.preventDefault();
    });

    // Swipes and trackpad scrolls settle on a slide; follow them.
    let queued = false;
    viewport.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          const settled = Math.round(viewport.scrollLeft / viewport.clientWidth);
          if (settled !== index) show(settled, false);
        });
      },
      { passive: true },
    );

    // Keep the current photo in place when the layout width changes.
    window.addEventListener('resize', () => {
      viewport.scrollTo({ left: index * viewport.clientWidth, behavior: 'auto' });
    });

    const href = root.dataset.href;
    if (href) viewport.addEventListener('click', () => window.location.assign(href));

    show(0, false);
  });
</script>
