---
/**
 * The current-work sheet on a navy site board: the jobs under way as a grid
 * of cells, each with a live marker, then the completed plants clients ask
 * about as a strip of plates that lead to their project pages.
 */
import { Image } from 'astro:assets';
import { onSite } from '../../data/story';
import { currentWork } from '../../data/company';
import { projects } from '../../data/projects';
import { galleryFor } from '../../lib/gallery';

interface Props {
  base: string;
  number?: string;
}

const { base, number = '01' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

/** The project behind a name on the sheet: exact first, then by the client's first word. */
const projectFor = (name: string) => {
  const key = name.toLowerCase();
  const first = key.split(' ')[0]!;
  return (
    projects.find((p) => p.name.toLowerCase() === key || key.startsWith(p.name.toLowerCase())) ??
    projects.find((p) => p.name.toLowerCase().startsWith(first))
  );
};

const pageFor = (name: string) => {
  const hit = projectFor(name);
  return hit ? `${base}/projects/${hit.slug}/` : undefined;
};

/** A photo for a job under way, preferring one that shows the site in progress. */
const photoFor = (name: string) => {
  const hit = projectFor(name);
  if (!hit) return undefined;
  const gallery = galleryFor(hit.slug);
  return gallery.find((photo) => /construction|scaffold|site|shed/i.test(photo.caption)) ?? gallery[0];
};
---

<section class="chapter hm-site" aria-labelledby="site-title">
  <div class="shell">
    <header class="chapter__head">
      <p class="section-no hm-site__no" aria-hidden="true">{number}</p>
      <h2 id="site-title" class="section-title hm-site__title">{onSite.title}</h2>
      <p class="lede hm-site__lede">{onSite.lede}</p>
    </header>

    <h3 class="hm-site__sub">{onSite.ongoingTitle}</h3>
    <ol class="hm-site__board" role="list">
      {
        currentWork.ongoing.map((job, i) => {
          const photo = photoFor(job.name);
          const href = pageFor(job.name);
          const Cell = href ? 'a' : 'div';
          return (
            <li class="hm-site__cell" data-hm style={`--i:${i}`}>
              <Cell class="hm-site__cell-inner" href={href} data-hm-tip>
                <p class="hm-site__cell-head">
                  <span class="hm-site__n" aria-hidden="true">{pad(i + 1)}</span>
                  <span class="hm-site__live">On site</span>
                </p>
                <p class="hm-site__name">{job.name}</p>
                <p class="hm-site__scope">{job.scope}</p>
                <p class="hm-site__foot">
                  {'area' in job && <span class="hm-site__area">{job.area}</span>}
                  <span class="hm-site__place">{job.location}</span>
                </p>
                {photo && (
                  <span class="hm-site__photo" aria-hidden="true">
                    <Image src={photo.src} alt="" widths={[320, 640]} sizes="16rem" loading="lazy" />
                  </span>
                )}
              </Cell>
            </li>
          );
        })
      }
    </ol>

    <div class="hm-site__done">
      <h3 id="site-done-title" class="hm-site__sub">{onSite.completedTitle}</h3>
      <ul class="hm-site__plates" role="list" aria-labelledby="site-done-title">
        {
          currentWork.completed.map((job) => {
            const href = pageFor(job.name);
            const inner = (
              <>
                <span class="hm-site__done-name">{job.name}</span>
                <span class="hm-site__done-place">{job.location}</span>
              </>
            );
            return (
              <li>{href ? <a class="hm-site__plate" href={href}>{inner}</a> : <span class="hm-site__plate">{inner}</span>}</li>
            );
          })
        }
        <li>
          <a class="hm-site__plate hm-site__plate--all" href={`${base}/projects/`}>
            <span class="hm-site__done-name">All projects</span>
            <span class="hm-site__done-place">Every site, with photographs</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hm-site {
    border-block: 3px solid var(--navy);
    background: var(--navy);
    color: #fff;
  }

  .hm-site .hm-site__no {
    -webkit-text-stroke-color: var(--orange);
  }

  .hm-site__title {
    color: #fff;
  }

  .hm-site__lede {
    color: #d5deea;
  }

  .hm-site__sub {
    margin-bottom: 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--orange);
  }

  /* The jobs under way as a board of cells, ruled in pale lines on navy. */
  .hm-site__board {
    --line: rgb(255 255 255 / 0.28);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding: 0;
    margin: 0;
    border-top: 6px solid var(--orange);
    background: var(--line);
  }

  .hm-site__cell {
    position: relative;
    display: grid;
    background: var(--navy);
  }

  /* A hovered cell rises above its neighbours so the tooltip is never clipped. */
  .hm-site__cell:hover {
    z-index: 3;
  }

  .hm-site__cell-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 15rem;
    padding: 1.25rem 1.35rem 1.35rem;
    text-decoration: none;
    color: inherit;
  }

  a.hm-site__cell-inner:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: -3px;
  }

  /* The project photograph is a tooltip: it appears while the pointer is on
     the project's name, floating below and to the right of the cursor, and
     follows it. Keyboard focus on the cell shows it in a fixed spot. */
  .hm-site__photo {
    position: absolute;
    top: 0;
    left: 0;
    /* Follows the pointer by translate, so tracking never re-lays the page;
       a short ease lets it trail the cursor instead of ticking after it. */
    translate: var(--x, 0px) var(--y, 0px);
    z-index: 2;
    width: 16rem;
    aspect-ratio: 4 / 3;
    border: 2px solid #fff;
    box-shadow: 0.5rem 0.5rem 0 var(--orange);
    background: var(--navy);
    opacity: 0;
    transform: translate(1.25rem, 1rem) scale(0.96);
    transform-origin: left top;
    transition:
      opacity 160ms ease,
      transform 220ms var(--ease-out),
      translate 160ms var(--ease-out);
    pointer-events: none;
  }

  .hm-site__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hm-site__cell-inner:has(.hm-site__name:hover) .hm-site__photo {
    opacity: 1;
    transform: translate(1.25rem, 1rem);
  }

  a.hm-site__cell-inner:focus-visible .hm-site__photo {
    top: 1rem;
    left: auto;
    right: 1rem;
    opacity: 1;
    translate: none;
    transform: none;
  }

  /* Without pointer tracking, the tooltip sits above the name. */
  .hm-site__name {
    position: relative;
  }

  .hm-site__cell-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .hm-site__n {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 900;
    line-height: 1;
    color: var(--orange);
  }

  /* A live marker: the dot breathes while the job is on site. */
  .hm-site__live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange);
  }

  .hm-site__live::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 0 rgb(240 152 88 / 0.6);
  }

  :global(.hm-motion) .hm-site__live::before {
    animation: hm-pulse 2.2s ease-out infinite;
  }

  @keyframes hm-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(240 152 88 / 0.6);
    }
    70% {
      box-shadow: 0 0 0 0.6rem rgb(240 152 88 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(240 152 88 / 0);
    }
  }

  .hm-site__name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.1rem + 1.2vw, 2.2rem);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
    color: #fff;
  }

  .hm-site__scope {
    color: #d5deea;
  }

  .hm-site__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .hm-site__area {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    background: var(--blue);
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
  }

  .hm-site__place {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #d5deea;
  }

  /* Completed plants as a strip of plates; the last leads to all projects. */
  .hm-site__done {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* The strip is a pale board on the navy: light blue cells with navy type. */
  .hm-site__plates {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 1px;
    padding: 1px;
    margin: 0;
    border-top: 3px solid #fff;
    background: var(--rule);
  }

  .hm-site__plates li {
    display: grid;
  }

  .hm-site__plate {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.3rem;
    min-height: 6rem;
    padding: 0.9rem 1rem;
    background: var(--sav-blue-tint);
    text-decoration: none;
    color: var(--navy);
    isolation: isolate;
  }

  a.hm-site__plate::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 380ms var(--ease-out);
  }

  a.hm-site__plate:hover::before,
  a.hm-site__plate:focus-visible::before {
    transform: none;
  }

  a.hm-site__plate:hover .hm-site__done-place,
  a.hm-site__plate:focus-visible .hm-site__done-place {
    color: var(--navy);
  }

  .hm-site__done-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .hm-site__done-place {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* The last plate leads to all projects; its name is set in SAV blue. */
  .hm-site__plate--all .hm-site__done-name {
    color: var(--blue-text);
  }

  a.hm-site__plate--all:hover .hm-site__done-name,
  a.hm-site__plate--all:focus-visible .hm-site__done-name {
    color: var(--navy);
  }

  .hm-site :focus-visible {
    outline-color: var(--orange);
  }

  :global(.hm-motion) .hm-site__cell[data-hm] {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 600ms var(--ease-out),
      transform 700ms var(--ease-out);
    transition-delay: calc(var(--i) * 90ms);
  }

  :global(.hm-motion) .hm-site__cell[data-hm].is-in {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 56rem) {
    .hm-site__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .hm-site__board {
      grid-template-columns: minmax(0, 1fr);
    }

    .hm-site__cell-inner {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hm-site__live::before {
      animation: none;
    }

    .hm-site__photo {
      transition: none;
    }
  }
</style>

<script>
  // The tooltip photo follows the pointer across its cell, updated at most
  // once a frame.
  document.querySelectorAll<HTMLElement>('[data-hm-tip]').forEach((cell) => {
    let pointer: PointerEvent | null = null;
    cell.addEventListener('pointermove', (event) => {
      if (!pointer) {
        requestAnimationFrame(() => {
          if (!pointer) return;
          const box = cell.getBoundingClientRect();
          cell.style.setProperty('--x', `${pointer.clientX - box.left}px`);
          cell.style.setProperty('--y', `${pointer.clientY - box.top}px`);
          pointer = null;
        });
      }
      pointer = event;
    });
  });
</script>
