---
/**
 * The yard, SAV's main selling point. The figure is set as large as the page
 * allows and wipes open on arrival; the yard photograph straightens as it
 * scrolls into place; the stock follows as one ruled strip of figures, then
 * the workshop where the formwork is made.
 */
import { Image } from 'astro:assets';
import YardIcon from '../YardIcon.astro';
import { ledger, yard } from '../../data/story';
import { warehouse, workshop } from '../../data/company';
import { capabilityGallery } from '../../lib/gallery';

interface Props {
  base: string;
  number?: string;
}

const { base, number = '02' } = Astro.props;
const yardPhoto = capabilityGallery('warehouse')[0];
---

<section class="chapter chapter--raised hm-yard" id="yard" aria-labelledby="yard-title" data-hm-progress>
  <div class="shell">
    <p class="section-no" aria-hidden="true">{number}</p>
    <h2 id="yard-title" class="hm-yard__title" data-hm>
      <span class="hm-yard__figure">{yard.figure}</span>
      <span class="hm-yard__rest">{yard.title}</span>
    </h2>

    <div class="hm-yard__body">
      {
        yardPhoto && (
          <figure class="hm-yard__photo">
            <Image
              src={yardPhoto.src}
              alt="Elevated view of SAV Construction's yard in Indore: stacks of shuttering and scaffolding, machinery and site vehicles."
              widths={[640, yardPhoto.src.width]}
              sizes="(max-width: 56rem) 100vw, 50vw"
              loading="lazy"
            />
            <figcaption>{yard.imageCaption}</figcaption>
          </figure>
        )
      }
      <div class="hm-yard__copy">
        <p class="hm-yard__acres"><span>{warehouse.acres}</span> of warehouse and yard in Indore</p>
        <p class="lede">{yard.lede}</p>
      </div>
    </div>

    <h3 class="hm-yard__sub">{ledger.title}</h3>
    <ol class="hm-stock" role="list">
      {
        ledger.rows.map((row, i) => (
          <li class="hm-stock__row" data-hm style={`--i:${i}`}>
            <YardIcon name={row.icon} class="hm-stock__icon" />
            <p class="hm-stock__qty">{row.value}</p>
            <h4 class="hm-stock__item">{row.label}</h4>
          </li>
        ))
      }
    </ol>

    <div class="hm-shop">
      <h3 class="hm-shop__title">{workshop.title}</h3>
      <p class="hm-shop__body">{workshop.body}</p>
    </div>

    <a class="btn btn--ghost" href={`${base}/capabilities/#yard`}>See the yard and workshop</a>
  </div>
</section>

<style>
  .hm-yard {
    --p: 1;
    overflow: hidden;
  }

  .hm-yard__title {
    display: grid;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Smaller than the hero headline, so the hero still leads the page. */
  .hm-yard__figure {
    width: fit-content;
    font-size: clamp(2.8rem, 1rem + 5.6vw, 6.8rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--blue-text);
  }

  .hm-yard__rest {
    margin-top: 0.3em;
    font-size: clamp(1.4rem, 0.9rem + 1.8vw, 2.6rem);
    font-weight: 800;
    line-height: 0.95;
  }

  /* The figure wipes open left to right as the heading arrives. The heading
     is what the observer watches: a fully clipped element never counts as
     visible, so the clip can only ever sit on a child of the observed one. */
  :global(.hm-motion) .hm-yard__title[data-hm] .hm-yard__figure {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 900ms var(--ease-in-out);
  }

  :global(.hm-motion) .hm-yard__title[data-hm].is-in .hm-yard__figure {
    clip-path: inset(0 0 0 0);
  }

  .hm-yard__body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .hm-yard__photo {
    margin: 0;
  }

  .hm-yard__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0.75rem 0.75rem 0 var(--orange);
  }

  /* Tilted like a print on the desk until it scrolls into place. */
  :global(.hm-motion) .hm-yard__photo {
    transform: rotate(calc((1 - var(--p)) * -5deg)) translateY(calc((1 - var(--p)) * 3rem));
  }

  .hm-yard__photo figcaption {
    margin-top: 1.1rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hm-yard__acres {
    padding-left: 1rem;
    border-left: 6px solid var(--orange);
    font-size: clamp(1.3rem, 1rem + 1.1vw, 1.9rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink);
  }

  .hm-yard__acres span {
    font-family: var(--font-display);
    font-size: 1.6em;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--blue-text);
  }

  .hm-yard__sub {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: 0.9rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* The stock reads as one strip: four figures across, labels tucked under. */
  .hm-stock {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    border-top: 3px solid var(--navy);
    border-bottom: 1px solid var(--rule);
  }

  .hm-stock__row {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1rem, 1.8vw, 1.4rem) clamp(1rem, 2vw, 1.5rem);
  }

  .hm-stock__row:first-child {
    padding-left: 0;
  }

  .hm-stock__row + .hm-stock__row {
    border-left: 1px solid var(--rule);
  }

  .hm-stock__row :global(.hm-stock__icon) {
    width: 4rem;
    height: 4rem;
    margin-bottom: 0.75rem;
    fill: none;
    stroke: var(--blue-text);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hm-stock__qty {
    font-size: clamp(2.2rem, 1.2rem + 2.4vw, 3.6rem);
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.01em;
    color: var(--blue-text);
  }

  .hm-stock__item {
    /* Wide enough for every label to sit on two lines. */
    max-width: 30ch;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  :global(.hm-motion) .hm-stock__row[data-hm] {
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 600ms var(--ease-out),
      transform 600ms var(--ease-out);
    transition-delay: calc(var(--i) * 90ms);
  }

  :global(.hm-motion) .hm-stock__row[data-hm].is-in {
    opacity: 1;
    transform: none;
  }

  /* The workshop has no photograph yet, so it stands as a filled panel. */
  .hm-shop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 0.75rem clamp(1.25rem, 3vw, 2.5rem);
    align-items: baseline;
    margin-block: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 3px solid var(--navy);
    background: var(--blue);
    color: var(--on-blue);
  }

  .hm-shop__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 3rem);
    font-weight: 900;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .hm-shop__body {
    font-size: 1.1rem;
  }

  @media (max-width: 56rem) {
    .hm-yard__body,
    .hm-shop {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Two by two; the second row rules off from the first. */
    .hm-stock {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hm-stock__row:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .hm-stock__row:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }
</style>
