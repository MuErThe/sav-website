---
import { root } from '../lib/paths';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Motion from '../components/Motion.astro';
import savLogo from '../assets/brand/sav-logo.png';
import savLogoWhite from '../assets/brand/sav-logo-white.png';
import UpclMark from '../components/UpclMark.astro';
import BrandLockup from '../components/BrandLockup.astro';
import Arrow from '../components/Arrow.astro';
import { company, contact } from '../data/company';
import { navFor, isCurrent } from '../lib/nav';
import { featuredProjects } from '../data/projects';
import '../styles/base.css';
import './theme.css';

interface Props {
  title: string;
  description: string;
  fullTitle?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  schema?: readonly Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, fullTitle, image, imageAlt, type, schema, noindex } = Astro.props;
const nav = navFor();
const path = Astro.url.pathname;
const year = new Date().getFullYear();
/** A Google Maps search for an office address. */
const mapsHref = (lines: readonly string[]) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(lines.join(', '))}`;
const fontHref =
  'https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600..900&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead
      title={title}
      description={description}
      fullTitle={fullTitle}
      image={image}
      imageAlt={imageAlt}
      type={type}
      schema={schema}
      noindex={noindex}
      fontHref={fontHref}
      themeColor="#f3f5f8"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- Above the sticky header, so it scrolls away as the page moves. -->
    <div class="topbar">
      <div class="shell">
        <BrandLockup />
      </div>
    </div>

    <header class="masthead">
      <div class="shell masthead__inner">
        <a class="brand" href={`${root}/`}>
          <Image src={savLogo} alt="" aria-hidden="true" class="brand__logo" height={60} densities={[1, 2]} loading="eager" />
          <span class="visually-hidden">{company.name}, home</span>
        </a>

        <button
          type="button"
          class="nav__toggle"
          aria-expanded="false"
          aria-controls="primary-nav"
          data-nav-toggle
        >
          <span class="nav__burger" aria-hidden="true"></span>
          Menu
        </button>

        <nav class="nav" id="primary-nav" aria-label="Primary">
          <ul class="nav__list" role="list">
            {
              nav
                .filter((item) => item.label !== 'Contact')
                .map((item) => (
                  <li>
                    <a
                      class="nav__link"
                      href={item.href}
                      aria-current={isCurrent(item.href, path) ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
            }
            <li><a class="nav__cta" href={`${root}/contact/`}>Start an enquiry</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="shell">
        <div class="footer__grid">
          <div>
            <a class="footer__brand" href={`${root}/`}>
              <Image src={savLogoWhite} alt="" aria-hidden="true" class="footer__logo" height={120} densities={[1, 2]} />
              <span class="visually-hidden">{company.name}, home</span>
            </a>
            <p class="footer__note footer__stack">
              <span>{company.legalName}</span>
              <span class="footer__upcl"><UpclMark class="footer__mark" />{company.backedBy}</span>
            </p>
          </div>

          <div>
            <p class="footer__heading">Explore</p>
            <ul class="footer__list" role="list">
              {
                nav.map((item) => (
                  <li>
                    <a class="footer__link" href={item.href}>
                      <span class="footer__link-text">{item.label}</span>
                      <Arrow class="footer__arrow" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <p class="footer__heading">Selected projects</p>
            <ul class="footer__list" role="list">
              {
                featuredProjects.map((project) => (
                  <li>
                    <a class="footer__link" href={`${root}/projects/${project.slug}/`}>
                      <span class="footer__link-text">{project.name}</span>
                      <Arrow class="footer__arrow" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <p class="footer__heading">Talk to us</p>
            <ul class="footer__list footer__list--contact" role="list">
              <li>
                <svg class="footer__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path>
                </svg>
                <a class="footer__link" href={contact.phoneHref}>
                  <span class="footer__link-text">{contact.phone}</span>
                  <Arrow class="footer__arrow" />
                </a>
              </li>
              <li>
                <svg class="footer__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M3 6h18v12H3z M3 7l9 6 9-6"></path>
                </svg>
                <a class="footer__link" href={contact.emailHref}>
                  <span class="footer__link-text">{contact.email}</span>
                  <Arrow class="footer__arrow" />
                </a>
              </li>
              <li>
                <svg class="footer__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z M8 10v7 M8 7v.01 M12 17v-7 M12 13a3 3 0 0 1 6 0v4"></path>
                </svg>
                <a class="footer__link" href={contact.linkedin} target="_blank" rel="noopener noreferrer">
                  <span class="footer__link-text">LinkedIn</span>
                  <Arrow class="footer__arrow" />
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
              {
                contact.offices.map((office, index) => (
                  <li>
                    <svg class="footer__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      {index === 0 ? (
                        <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z M12 12.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path>
                      ) : (
                        <path d="M4 21V5h10v16 M14 9h6v12 M7 8h3 M7 12h3 M7 16h3 M17 13h1 M17 17h1 M2 21h20"></path>
                      )}
                    </svg>
                    <a
                      class="footer__link footer__link--block"
                      href={mapsHref(office.lines)}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span>
                        <span class="footer__label">{office.label}</span>
                        <span class="footer__link-text">{office.lines.join(', ')}</span>
                        <Arrow class="footer__arrow footer__arrow--inline" />
                        <span class="visually-hidden"> (opens Google Maps in a new tab)</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="footer__bar">
          <p>&copy; {year} {company.legalName} All rights reserved.</p>
          <p>Indore, Madhya Pradesh, India</p>
        </div>
      </div>
    </footer>

    <Motion />

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const nav = document.getElementById('primary-nav');
      const mobile = window.matchMedia('(max-width: 60rem)');

      function apply(): void {
        if (!nav || !toggle) return;
        // The nav is only collapsible at narrow widths; above that it is always shown.
        const open = mobile.matches && toggle.getAttribute('aria-expanded') === 'true';
        nav.hidden = mobile.matches && !open;
        // Open, the menu fills the screen below the header and the page stays put.
        const head = toggle.closest('header');
        if (open && head) document.documentElement.style.setProperty('--menu-top', `${head.getBoundingClientRect().bottom}px`);
        document.documentElement.classList.toggle('menu-open', open);
      }

      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        apply();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
        toggle.setAttribute('aria-expanded', 'false');
        apply();
        toggle.focus();
      });

      mobile.addEventListener('change', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        apply();
      });

      apply();
    </script>
  </body>
</html>
